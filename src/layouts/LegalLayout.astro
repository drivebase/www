---
import { siteConfig } from "../config/site";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	updated: string;
}

const { title, description, updated } = Astro.props;
const pageTitle = `${title} · ${siteConfig.name}`;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content="index, follow" />
		<meta property="og:type" content="article" />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<style is:inline>
			html,
			body {
				margin: 0;
				background: rgb(7 9 13);
			}
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
		</style>
		<script defer src="https://analytics.mxv.sh/script.js" data-website-id="432ec307-33fd-4912-85aa-53d28440e058"></script>
	</head>
	<body class="bg-background text-foreground">
		<div class="relative min-h-screen antialiased">
			<header class="border-b border-white/5">
				<div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-6">
					<a href="/" class="flex items-center gap-2.5">
						<img src="/favicon.svg" alt="" width="22" height="22" />
						<span class="font-semibold tracking-tight text-white">{siteConfig.name}</span>
					</a>
					<a href="/" class="text-sm text-white/50 transition-colors hover:text-white">← Back to home</a>
				</div>
			</header>

			<main class="mx-auto max-w-3xl px-6 py-16">
				<p class="font-mono text-xs uppercase tracking-wider text-white/40">Legal</p>
				<h1 class="mt-3 text-4xl font-semibold tracking-[-0.03em] text-white">{title}</h1>
				<p class="mt-3 text-sm text-white/40">Last updated {updated}</p>

				<article class="legal mt-10">
					<slot />
				</article>
			</main>

			<footer class="border-t border-white/5">
				<div class="mx-auto flex max-w-3xl flex-col items-center justify-between gap-3 px-6 py-8 text-xs text-white/40 sm:flex-row">
					<span class="font-mono">© 2026 {siteConfig.name}</span>
					<div class="flex items-center gap-4">
						<a href="/privacy" class="transition-colors hover:text-white">Privacy</a>
						<a href="/terms" class="transition-colors hover:text-white">Terms</a>
					</div>
				</div>
			</footer>
		</div>

		<style is:inline>
			.legal {
				color: rgb(255 255 255 / 0.6);
				font-size: 0.95rem;
				line-height: 1.75;
			}
			.legal h2 {
				margin-top: 2.5rem;
				margin-bottom: 0.75rem;
				color: rgb(255 255 255);
				font-size: 1.25rem;
				font-weight: 600;
				letter-spacing: -0.01em;
			}
			.legal h3 {
				margin-top: 1.75rem;
				margin-bottom: 0.5rem;
				color: rgb(255 255 255 / 0.9);
				font-size: 1rem;
				font-weight: 600;
			}
			.legal p {
				margin: 0 0 1rem;
			}
			.legal ul {
				margin: 0 0 1rem;
				padding-left: 1.25rem;
				list-style: disc;
			}
			.legal li {
				margin-bottom: 0.4rem;
			}
			.legal a {
				color: rgb(var(--color-accent-rgb));
				text-decoration: underline;
				text-underline-offset: 2px;
			}
			.legal strong {
				color: rgb(255 255 255 / 0.85);
				font-weight: 600;
			}
		</style>
	</body>
</html>
